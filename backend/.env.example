# MPloyChek Backend Environment Configuration

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=mploychek-production-grade-jwt-secret-key-2026

# JWT Expiration
JWT_EXPIRES_IN=8h

# MongoDB Connection String (OPTIONAL)
# - If omitted or left blank: MPloyChek automatically starts an embedded in-memory MongoDB
#   and auto-populates it with demo users & verification records (zero configuration required).
# - If specified: MPloyChek connects to your MongoDB instance and auto-seeds initial data
#   if the database is empty.
# Examples:
# MONGO_URI=mongodb://localhost:27017/mploychek
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mploychek?retryWrites=true&w=majority
MONGO_URI=
